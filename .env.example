# Choose the model provider:
#   openrouter = OpenRouter (default)
#   opencode   = OpenCode Go
#   local      = any OpenAI-compatible local server
HARNESS_PROVIDER=openrouter
# HARNESS_PROVIDER=opencode
# HARNESS_PROVIDER=local

# --- OpenRouter -------------------------------------------------------
# Create an API key at https://openrouter.ai/settings/keys and export it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=minimal-harness
# Optional endpoint override. Leave commented to use OpenRouter.
# OPENROUTER_BASE_URL=https://your-proxy/v1/chat/completions

# --- OpenCode Go ------------------------------------------------------
# Subscribe at https://opencode.ai/console, then copy the API key.
# Set HARNESS_PROVIDER=opencode above to use these settings.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
# Full chat-completions endpoint. A base URL ending in /v1 also works.
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1/chat/completions
# Older/alternate key name is also accepted.
# OPENCODE_GO_API_KEY=

# --- Local model ------------------------------------------------------
# Set HARNESS_PROVIDER=local above to use these settings.
# Ollama default:
# LOCAL_BASE_URL=http://localhost:11434/v1/chat/completions
# LM Studio:  http://localhost:1234/v1/chat/completions
# llama.cpp:  http://localhost:8080/v1/chat/completions
# vLLM:       http://localhost:8000/v1/chat/completions
# LOCAL_MODEL=qwen2.5-coder:7b
# LOCAL_API_KEY=
# The local model must support OpenAI-compatible tool calls for the
# interactive agent. The optimizer only needs chat completions.

# Seconds before a model request is abandoned and retried (default 180).
# HARNESS_MODEL_TIMEOUT=180

# Desktop UI: classic (MaryAnn's sage interface) vs hal (red-eye push-to-talk).
# Optional: cyber (dark neon voice interface).
HARNESS_UI_MODE=classic
# HARNESS_UI_MODE=hal
# HARNESS_UI_MODE=cyber

# Where generated projects are created. Defaults to ~/HarnessProjects so new
# code never lands in the Minimal Harness source tree.
# HARNESS_WORKSPACE=~/HarnessProjects

# Adversarially review final answers with a second model call.
# 1 = always, 0 = never, auto = only tool-backed or long answers.
HARNESS_ANSWER_REVIEW=1

# Token-saving context controls.
# Include coding standards only for coding tasks: auto, 1, or 0.
HARNESS_CODING_STANDARDS=auto
# Compact the conversation above this many characters (~4 chars per token).
HARNESS_CONTEXT_CHARS=60000
# Number of newest messages kept when compacting.
HARNESS_CONTEXT_KEEP=16
# Maximum characters a single tool result may add to the context.
HARNESS_TOOL_OUTPUT_LIMIT=12000
# Bounded reviewer-test repair turns.
HARNESS_REPAIR_ATTEMPTS=2
# Optional JSONL log of per-call token usage.
# HARNESS_USAGE_LOG=runs/usage.jsonl

# Voice settings for hal and cyber modes.
# Seconds to wait for a spoken answer before returning to idle.
HARNESS_ASK_TIMEOUT=45
HARNESS_VOICE=en-US-AriaNeural
HARNESS_WHISPER_MODEL=base.en
# Never make unauthenticated Hugging Face requests; use cached models only.
# Set to false only when HARNESS_HF_TOKEN is configured.
HARNESS_WHISPER_LOCAL_ONLY=true
# Optional Hugging Face token for authenticated Whisper model downloads.
# HARNESS_HF_TOKEN=hf_...
# Optional custom model cache directory.
# HARNESS_WHISPER_CACHE=~/.cache/huggingface/hub
